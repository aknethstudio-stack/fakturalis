# --------------------------------------------
# .gitattributes — consistent diffs and EOLs
# --------------------------------------------

# Default: let Git detect text files and normalize LF in the repo
* text=auto

# Enforce LF in the working tree for source-like files (portable across OSes)
*.sh           text eol=lf
*.bash         text eol=lf
*.zsh          text eol=lf
*.ps1          text eol=lf

*.js           text eol=lf
*.jsx          text eol=lf
*.ts           text eol=lf
*.tsx          text eol=lf
*.mjs          text eol=lf
*.cjs          text eol=lf

*.json         text eol=lf
*.jsonc        text eol=lf
*.yml          text eol=lf
*.yaml         text eol=lf
*.toml         text eol=lf
*.xml          text eol=lf
*.graphql      text eol=lf
*.gql          text eol=lf

*.css          text eol=lf
*.scss         text eol=lf
*.sass         text eol=lf
*.less         text eol=lf

*.html         text eol=lf
*.md           text eol=lf
*.mdx          text eol=lf
*.txt          text eol=lf
*.csv          text eol=lf
*.env          text eol=lf
*.env.*        text eol=lf
*.conf         text eol=lf
*.ini          text eol=lf

# Lock and config files as LF for stable diffs
package-lock.json text eol=lf
pnpm-lock.yaml    text eol=lf
yarn.lock         text eol=lf
bun.lockb         -text

# -------------------------
# Binary and non-diff files
# -------------------------
# Images
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.webp binary
*.ico  binary
*.bmp  binary
*.tif  binary
*.tiff binary
*.svg  text eol=lf   linguist-detectable=true

# Fonts
*.woff   binary
*.woff2  binary
*.ttf    binary
*.eot    binary
*.otf    binary

# Media
*.mp3  binary
*.ogg  binary
*.mp4  binary
*.mov  binary
*.mkv  binary
*.webm binary
*.wav  binary

# Archives / compressed
*.zip  binary
*.7z   binary
*.gz   binary
*.bz2  binary
*.xz   binary
*.br   binary
*.tar  binary
*.tgz  binary

# Databases / misc binaries
*.sqlite  binary
*.db      binary
*.pdf     binary

# -------------------------
# GitHub Linguist directives
# -------------------------
# Treat build outputs and caches as generated (excluded from language stats)
.next/**              linguist-generated=true
dist/**               linguist-generated=true
build/**              linguist-generated=true
out/**                linguist-generated=true
coverage/**           linguist-generated=true
storybook-static/**   linguist-generated=true

# Minified bundles are generated
*.min.js              linguist-generated=true
*.min.css             linguist-generated=true
*.bundle.*            linguist-generated=true

# Documentation
docs/**               linguist-documentation
README.md             linguist-documentation

# -------------------------
# Export control (git archive)
# Exclude development-only files from `git archive`
# -------------------------
.github/              export-ignore
.husky/               export-ignore
.vscode/              export-ignore
.idea/                export-ignore
.eslintrc.*           export-ignore
.stylelintrc.*        export-ignore
.prettierrc*          export-ignore
.prettierignore       export-ignore
commitlint.config.*   export-ignore
.postcssrc*           export-ignore
postcss.config.*      export-ignore
tailwind.config.*     export-ignore
tsconfig.*            export-ignore
jest.config.*         export-ignore
playwright.config.*   export-ignore
vitest.config.*       export-ignore

# -------------------------
# Windows-specific handling
# -------------------------
# Windows batch files use CRLF
*.bat          text eol=crlf
*.cmd          text eol=crlf
*.ps1          text eol=lf

# Windows shortcuts and system files
*.lnk          binary
*.exe          binary
*.dll          binary
*.msi          binary
*.cab          binary

# macOS system files
.DS_Store      binary
*.dmg          binary
*.app          binary

# Linux/Unix system files
*.deb          binary
*.rpm          binary
*.AppImage     binary

# IDE and editor files
.vscode/       export-ignore
.zed/          export-ignore
.idea/         export-ignore
*.swp          binary
*.swo          binary
*~             binary

# Temporary and cache files
*.tmp          binary
*.temp         binary
*.cache        binary
thumbs.db      binary
Thumbs.db      binary
ehthumbs.db    binary
Desktop.ini    text

# Log files
*.log          text eol=lf
