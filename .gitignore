# Dependencies
node_modules/

# Next.js build output
.next/
out/

# General build artifacts
dist/
build/

# Caches
.cache/
.parcel-cache/
.turbo/
.swc/
.eslintcache
.stylelintcache
.nyc_output/
coverage/
.vite/
.vite-inspect/
.jest-cache/
jest-cache/
tsconfig.tsbuildinfo
*.tsbuildinfo

# Package manager caches
.pnpm-store/
.npm/

# Yarn (Berry) - keep important subfolders if using Yarn 2+
.yarn/*
!.yarn/releases
!.yarn/plugins
!.yarn/sdks
!.yarn/versions

# Bun
.bun/
.bun-cache/

# Hosting / platform artifacts
.vercel/
.netlify/
.serverless/
.firebase/
.aws-sam/

# Logs and temp files
logs/
*.log
*.log.*
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
tmp/
temp/
.tmp/
.temp/
*.tmp
*.temp
*.swp
*.swo
*~

# Environment files (keep examples)
.env
.env.*
!.env.example
!.env.*.example
.envrc
.env.local
.env.development.local
.env.test.local
.env.production.local

# Test artifacts
reports/
test-results/
junit.xml
cypress/videos/
cypress/screenshots/
cypress/downloads/
playwright-report/
playwright/.cache/
playwright/.reporter-temp/
.vitest/
vitest-report/

# Storybook
storybook-static/
dist-storybook/

# OS / IDE / VCS noise
