{
  "name": "fakturalis",
  "displayName": "Fakturalis",
  "version": "1.0.0",
  "description": "Fakturalis - Program do fakturowania",
  "main": "index.js",
  "scripts": {
    "dev": "next dev",
    "dev:turbo": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky",
    "test": "cross-env NODE_ENV=test jest",
    "test:coverage": "cross-env NODE_ENV=test jest --coverage",
    "test:watch": "cross-env NODE_ENV=test jest --watch",
    "test:ci": "cross-env NODE_ENV=test jest --ci --coverage --watchAll=false",
    "type-check": "tsc --noEmit",
    "commitlint": "commitlint --from=HEAD~1",
    "stylelint": "stylelint \"src/**/*.{css,scss,sass}\"",
    "stylelint:fix": "stylelint \"src/**/*.{css,scss,sass}\" --fix",
    "clean": "rimraf .next dist build coverage .turbo .swc tsconfig.tsbuildinfo .eslintcache .stylelintcache",
    "clean:node": "rimraf node_modules package-lock.json",
    "clean:all": "npm-run-all clean clean:node",
    "postinstall": "npm run type-check",
    "predev": "npm run type-check",
    "prebuild": "npm run type-check && npm run lint && npm run test:ci",
    "release": "standard-version",
    "release:patch": "standard-version --release-as patch",
    "release:minor": "standard-version --release-as minor",
    "release:major": "standard-version --release-as major",
    "changelog": "standard-version --dry-run",
    "check": "npm-run-all type-check lint stylelint test:ci",
    "hint": "hint http://localhost:3000",
    "hint:files": "hint ./public/",
    "hint:dev": "hint --config development http://localhost:3000",
    "setup": "./scripts/setup.sh",
    "setup:windows": "./scripts/setup.ps1",
    "node-version": "node --version && npm --version",
    "analyze": "cross-env ANALYZE=true npm run build",
    "analyze:server": "cross-env BUNDLE_ANALYZE=server npm run build",
    "analyze:browser": "cross-env BUNDLE_ANALYZE=browser npm run build",
    "dev:clean": "npm run clean && npm run dev",
    "test:update": "jest --updateSnapshot",
    "coverage:upload": "node scripts/upload-coverage.mjs",
    "coverage:codacy": "npm run test:ci && npm run coverage:upload",
    "deps:check": "npm outdated",
    "deps:update": "npm update"
  },
  "keywords": [
    "faktury",
    "fakturowanie",
    "CRM",
    "AKNETH Studio",
    "invoice",
    "billing",
    "accounting",
    "business",
    "saas",
    "nextjs",
    "typescript",
    "supabase",
    "polish-market"
  ],
  "engines": {
    "npm": ">=10.x",
    "node": ">=22.x"
  },
  "private": true,
  "author": {
    "name": "AKNETH Studio Katarzyna Pawłowska-Malesa",
    "email": "akneth.studio@gmail.com",
    "url": "https://akneth-studio.vercel.app"
  },
  "contributors": [
    "aknethstudio-stack",
    "reisene"
  ],
  "license": "AGPL-3.0-only",
  "homepage": "https://fakturalis.pl",
  "repository": {
    "type": "git",
    "url": "https://github.com/aknethstudio-stack/fakturalis.git"
  },
  "funding": [
    {
      "type": "commercial",
      "url": "https://fakturalis.pl/pricing"
    },
    {
      "type": "patreon",
      "url": "https://www.patreon.com/AKNETHStudio"
    },
    {
      "type": "github",
      "url": "https://github.com/sponsors/aknethstudio-stack"
    },
    {
      "type": "individual",
      "url": "https://akneth-studio.vercel.app"
    }
  ],
  "bugs": {
    "url": "https://github.com/aknethstudio-stack/fakturalis/issues",
    "email": "akneth.studio+projects@gmail.com"
  },
  "type": "module",
  "dependencies": {
    "@hcaptcha/react-hcaptcha": "^1.12.1",
    "@headlessui/react": "^2.2.9",
    "@hookform/resolvers": "^5.2.2",
    "@sentry/nextjs": "^10.19.0",
    "@supabase/auth-helpers-nextjs": "^0.10.0",
    "@supabase/auth-helpers-react": "^0.5.0",
    "@supabase/ssr": "^0.7.0",
    "@supabase/supabase-js": "^2.75.0",
    "@tanstack/react-query": "^5.90.2",
    "@types/dompurify": "^3.2.0",
    "@types/jsdom": "^27.0.0",
    "@upstash/ratelimit": "^2.0.6",
    "@upstash/redis": "^1.35.5",
    "@vercel/analytics": "^1.5.0",
    "@vercel/speed-insights": "^1.2.0",
    "clsx": "^2.1.1",
    "dompurify": "^3.2.7",
    "exceljs": "^4.4.0",
    "jsdom": "^27.0.0",
    "jspdf": "^3.0.3",
    "jspdf-autotable": "^5.0.2",
    "next": "^15.5.4",
    "nodemailer": "^7.0.9",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-hook-form": "^7.65.0",
    "react-icons": "^5.5.0",
    "react-to-print": "^3.1.1",
    "recharts": "^3.2.1",
    "tailwind-merge": "^3.3.1",
    "xml2js": "^0.6.2",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.1.0",
    "@commitlint/config-conventional": "^20.0.0",
    "@eslint/eslintrc": "^3.3.1",
    "@eslint/js": "^9.37.0",
    "@tailwindcss/postcss": "^4.1.14",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.7.1",
    "@types/nodemailer": "^7.0.2",
    "@types/react": "^19.2.2",
    "@types/xml2js": "^0.4.14",
    "@typescript-eslint/eslint-plugin": "^8.46.0",
    "@typescript-eslint/parser": "^8.46.0",
    "autoprefixer": "^10.4.21",
    "cross-env": "^10.1.0",
    "eslint": "^9.37.0",
    "eslint-config-next": "^15.5.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.4",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.0",
    "husky": "^9.1.7",
    "jest": "^30.2.0",
    "jest-environment-jsdom": "^30.2.0",
    "lint-staged": "^16.2.4",
    "npm-run-all": "^4.1.5",
    "postcss": "^8.5.6",
    "postcss-scss": "^4.0.9",
    "prettier": "^3.6.2",
    "prettier-plugin-tailwindcss": "^0.6.14",
    "rimraf": "^6.0.1",
    "sass": "^1.93.2",
    "standard-version": "^9.5.0",
    "stylelint": "^16.25.0",
    "stylelint-config-standard-scss": "^16.0.0",
    "tailwindcss": "^4.1.14",
    "ts-jest": "^29.4.5",
    "typescript": "^5.9.3"
  },
  "lint-staged": {
    "**/*.{js,jsx,ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "**/*.{css,scss,sass}": [
      "stylelint --fix",
      "prettier --write"
    ],
    "**/*.{json,md,mdx,yml,yaml,html,graphql,svg,toml,xml}": "prettier --write"
  },
  "standard-version": {
    "header": "# Changelog\n\nAll notable changes to this project will be documented in this file.\n",
    "commitAll": true,
    "releaseCommitMessageFormat": "chore(release): v{{currentTag}}",
    "tagPrefix": "v"
  }
}
