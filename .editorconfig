root = true

# Global defaults
[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = space
indent_size = 2
trim_trailing_whitespace = true

# Markdown: keep trailing spaces (used for hard line breaks)
[*.md]
trim_trailing_whitespace = false

[*.mdx]
trim_trailing_whitespace = false

# YAML
[*.yml]
indent_size = 2

[*.yaml]
indent_size = 2

# JSON, CSS, SCSS, HTML, JS/TS
[*.{json,css,scss,html,js,jsx,ts,tsx}]
indent_size = 2

# Shell scripts
[*.{sh,bash,zsh}]
end_of_line = lf
insert_final_newline = true

# Windows batch scripts
[*.{bat,cmd}]
end_of_line = crlf

# Makefiles require tabs
[Makefile]
indent_style = tab
tab_width = 4

# Python files
[*.py]
indent_size = 4

# Go files
[*.go]
indent_style = tab
tab_width = 4

# C/C++ files
[*.{c,cpp,cc,cxx,h,hpp}]
indent_size = 4

# Java files
[*.java]
indent_size = 4

# PHP files
[*.php]
indent_size = 4

# SQL files
[*.sql]
indent_size = 2

# XML files
[*.{xml,xsl,xslt,dtd}]
indent_size = 2

# Config files
[*.{ini,cfg,conf,config}]
indent_size = 2

# Environment files
[.env*]
insert_final_newline = true
trim_trailing_whitespace = true

# Lock files - no formatting
[{package-lock.json,yarn.lock,pnpm-lock.yaml,bun.lockb}]
insert_final_newline = false
trim_trailing_whitespace = false

# Git files
[.git*]
trim_trailing_whitespace = true
insert_final_newline = true
