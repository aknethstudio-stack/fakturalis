{
  "extends": ["development"],
  "hints": {
    "axe/aria": [
      "error",
      {
        "aria-valid-attr-value": "off",
      },
    ],
    "axe/forms": [
      "error",
      {
        "label": "off",
      },
    ],
    "axe/keyboard": [
      "error",
      {
        "nested-interactive": "off",
      },
    ],
    "axe/name-role-value": [
      "error",
      {
        "link-name": "off",
        "button-name": "off",
      },
    ],
    "axe/parsing": [
      "error",
      {
        "duplicate-id-active": "off",
        "duplicate-id-aria": "off",
      },
    ],
    "axe/structure": [
      "error",
      {
        "list": "off",
        "listitem": "off",
      },
    ],
    "axe/text-alternatives": [
      "error",
      {
        "image-alt": "off",
      },
    ],
    "babel-config/is-valid": "error",
    "compat-api/css": [
      "error",
      {
        "ignore": [
          "backdrop-filter",
          "scrollbar-width",
          "scrollbar-color",
          "-webkit-scrollbar",
          "-webkit-scrollbar-track",
          "-webkit-scrollbar-thumb",
          "user-select",
        ],
      },
    ],
    "compat-api/html": [
      "error",
      {
        "ignore": [
          "meta[name=theme-color]",
          "meta[name=apple-mobile-web-app-capable]",
          "meta[name=apple-mobile-web-app-status-bar-style]",
          "link[rel=manifest]",
        ],
      },
    ],
    "create-element-svg": "error",
    "css-prefix-order": "error",
    "disown-opener": "error",
    "highest-available-document-mode": "error",
    "html-checker": [
      "error",
      {
        "ignore": [
          "Element \"style\" not allowed as child of element \"body\" in this context.",
          "Consider using the \"h1\" element as a top-level heading only",
        ],
      },
    ],
    "http-cache": "error",
    "http-compression": [
      "error",
      {
        "resource": {
          "requests": [
            {
              "url": "https://fonts.googleapis.com/.*",
              "headers": {
                "accept-encoding": "gzip, deflate, br",
              },
            },
          ],
        },
      },
    ],
    "https-only": [
      "error",
      {
        "ignore": ["localhost"],
      },
    ],
    "image-optimization-cloudinary": "off",
    "manifest-app-name": "error",
    "manifest-exists": "error",
    "manifest-file-extension": "error",
    "manifest-is-valid": "error",
    "meta-charset-utf-8": "error",
    "meta-viewport": "error",
    "minified-js": "off",
    "no-bom": "error",
    "no-broken-links": [
      "error",
      {
        "ignore": ["mailto:", "tel:", "#"],
      },
    ],
    "no-disallowed-headers": [
      "error",
      {
        "ignore": ["server"],
      },
    ],
    "no-html-only-headers": [
      "error",
      {
        "ignore": ["content-security-policy", "x-content-type-options", "x-frame-options"],
      },
    ],
    "no-http-redirects": "error",
    "no-inline-styles": [
      "error",
      {
        "ignore": ["style[data-emotion]", "style[data-styled]"],
      },
    ],
    "no-protocol-relative-urls": "error",
    "no-small-error-pages": "error",
    "no-vulnerable-javascript-libraries": "error",
    "performance-budget": [
      "error",
      {
        "connectionType": "3GSlow",
        "loadTime": 5,
        "size": {
          "total": 1000,
        },
      },
    ],
    "scoped-svg-styles": "error",
    "sri": [
      "error",
      {
        "baseline": "sha384",
      },
    ],
    "ssllabs": [
      "error",
      {
        "grade": "A+",
        "ssllabs": {
          "scan": false,
        },
      },
    ],
    "typescript-config/consistent-casing": "error",
    "typescript-config/import-helpers": "error",
    "typescript-config/is-valid": "error",
    "typescript-config/no-comments": "off",
    "typescript-config/strict": "error",
    "typescript-config/target": [
      "error",
      {
        "target": "es2022",
      },
    ],
    "validate-set-cookie-header": "error",
    "webpack-config/is-valid": "error",
    "webpack-config/modules-false-babel": "error",
    "webpack-config/no-devtool-in-prod": "error",
  },
  "browserslist": ["defaults", "not IE 11", "not op_mini all"],
  "formatters": ["html", "summary"],
  "parsers": [
    "babel-config",
    "css",
    "html",
    "javascript",
    "jsx",
    "less",
    "manifest",
    "sass",
    "typescript",
    "tsx",
    "webpack-config",
  ],
}
