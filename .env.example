# InvoiceForge — Example environment variables
# Copy this file to `.env.local` (for local dev) or set these in your hosting provider (e.g. Vercel).
# Never commit real secrets to your repository.

# -----------------------------------------------------------------------------
# App
# -----------------------------------------------------------------------------
# Public URL of your app (used in links, redirects, etc.)
# On Vercel, set this to your production domain (e.g. https://your-domain.com)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional: public app name (can be read in the UI)
NEXT_PUBLIC_APP_NAME=InvoiceForge

# Optional: environment label for client-side (development|preview|production)
NEXT_PUBLIC_APP_ENV=development

# -----------------------------------------------------------------------------
# Supabase (Public — used by the browser)
# -----------------------------------------------------------------------------
# Supabase project URL (found in your Supabase dashboard)
NEXT_PUBLIC_SUPABASE_URL=

# Supabase anon public API key (found in your Supabase dashboard)
# Treat as public, but rotate if leaked.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# -----------------------------------------------------------------------------
# Supabase (Server-only — DO NOT expose on the client)
# -----------------------------------------------------------------------------
# Service role key with elevated privileges (never expose to the browser)
SUPABASE_SERVICE_ROLE_KEY=

# Optional: JWT secret (only if you manage your own JWT verification)
# SUPABASE_JWT_SECRET=

# -----------------------------------------------------------------------------
# hCaptcha (Public)
# -----------------------------------------------------------------------------
# hCaptcha site key (public, can be exposed in browser)
# Get this from https://dashboard.hcaptcha.com/sites
NEXT_PUBLIC_HCAPTCHA_SITE_KEY=

# -----------------------------------------------------------------------------
# Node/Runtime
# -----------------------------------------------------------------------------
# Recommended to keep server-side dates deterministic (adjust as needed)
# TZ=UTC
