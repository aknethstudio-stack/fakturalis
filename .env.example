# InvoiceForge — Example environment variables
# Copy this file to `.env.local` (for local dev) or set these in your hosting provider (e.g. Vercel).
# Never commit real secrets to your repository.

# -----------------------------------------------------------------------------
# App
# -----------------------------------------------------------------------------
# Public URL of your app (used in links, redirects, etc.)
# On Vercel, set this to your production domain (e.g. https://your-domain.com)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional: public app name (can be read in the UI)
NEXT_PUBLIC_APP_NAME=InvoiceForge

# Production URL for metadata (will be overridden in production env)
NEXT_PUBLIC_SITE_URL=https://invoiceforge.pl

# -----------------------------------------------------------------------------
# Supabase (Public — used by the browser)
# -----------------------------------------------------------------------------
# Supabase project URL (found in your Supabase dashboard)
NEXT_PUBLIC_SUPABASE_URL=

# Supabase anon public API key (found in your Supabase dashboard)
# Treat as public, but rotate if leaked.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# -----------------------------------------------------------------------------
# Supabase (Server-only — DO NOT expose on the client)
# -----------------------------------------------------------------------------
# Service role key with elevated privileges (never expose to the browser)
SUPABASE_SERVICE_ROLE_KEY=

# Supabase database password (for direct database access if needed)
# SUPABASE_BASE_PASS=

# Optional: JWT secret (only if you manage your own JWT verification)
# SUPABASE_JWT_SECRET=

# -----------------------------------------------------------------------------
# hCaptcha
# -----------------------------------------------------------------------------
# hCaptcha site key (public, can be exposed in browser)
# Get this from https://dashboard.hcaptcha.com/sites
NEXT_PUBLIC_HCAPTCHA_SITE_KEY=

# hCaptcha secret key (server-side only - DO NOT expose to client)
# Used for server-side verification of hCaptcha responses
HCAPTCHA_SECRET_KEY=

# -----------------------------------------------------------------------------
# KSeF (Krajowy System e-Faktur)
# -----------------------------------------------------------------------------
# Demo environment identifier for testing (can be public)
KSEF_DEMO_IDENTIFIER=demo_user

# Production KSeF certificate (Base64 encoded - server-side only)
# KSEF_CERTIFICATE=

# Production KSeF certificate password (server-side only)  
# KSEF_CERTIFICATE_PASSWORD=

# Production KSeF identifier/NIP (server-side only)
# KSEF_IDENTIFIER=

# -----------------------------------------------------------------------------
# GUS API (Główny Urząd Statystyczny) - OPCJONALNE
# -----------------------------------------------------------------------------
# GUS API user key for company data lookup (server-side only)
# Test environment: use test key from GUS documentation
# Production: send email to regon_bir@stat.gov.pl with your data
# Leave empty if you don't need GUS - CEIDG and KRS will still work
# GUS_API_KEY=abcd123456789012345678901234567890

# -----------------------------------------------------------------------------
# Node/Runtime
# -----------------------------------------------------------------------------
# Recommended to keep server-side dates deterministic (adjust as needed)
# TZ=UTC
